rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateId(dateStr) {
      return dateStr is string && dateStr.size() == 10 && dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapOwner() {
      return isVerified() && request.auth.token.email == 'emsrkl1669@gmail.com';
    }

    function isAdmin() {
      return isBootstrapOwner() || (
        isVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true
      );
    }

    function isSuperAdmin() {
      return isBootstrapOwner() || (
        isVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // --- Validation Blueprints ---
    function isValidClinicConfig(data) {
      return data.keys().hasAll(['bookingPaused', 'pauseReason', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['bookingPaused', 'pauseReason', 'updatedAt', 'updatedBy'])
        && data.bookingPaused is bool
        && data.pauseReason is string && data.pauseReason.size() <= 240
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128;
    }

    function isValidScheduleDate(data, dateStr) {
      return data.keys().hasAll(['dateStr', 'isOpen', 'maxPerSlot', 'note', 'updatedAt'])
        && data.keys().hasOnly(['dateStr', 'isOpen', 'maxPerSlot', 'note', 'updatedAt'])
        && data.dateStr is string && data.dateStr == dateStr && isValidDateId(data.dateStr)
        && data.isOpen is bool
        && data.maxPerSlot is int && data.maxPerSlot >= 1 && data.maxPerSlot <= 20
        && data.note is string && data.note.size() <= 200
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidPublicQueueItem(data, bookingId) {
      return data.keys().hasAll(['bookingId', 'queueNo', 'queueType', 'bookingDate', 'bookingTime', 'status', 'updatedAt'])
        && data.keys().hasOnly(['bookingId', 'queueNo', 'queueType', 'bookingDate', 'bookingTime', 'status', 'updatedAt'])
        && data.bookingId is string && data.bookingId == bookingId && isValidId(data.bookingId)
        && data.queueNo is string && data.queueNo.size() >= 2 && data.queueNo.size() <= 16
        && data.queueType in ['regular', 'special']
        && data.bookingDate is string && isValidDateId(data.bookingDate)
        && data.bookingTime is string && data.bookingTime.size() >= 5 && data.bookingTime.size() <= 40
        && data.status in ['waiting', 'calling', 'completed', 'cancelled']
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidBookingRecord(data, bookingId) {
      return data.keys().hasAll([
          'bookingId', 'queueNo', 'queueType', 'bookingDate', 'bookingTime',
          'status', 'fullName', 'age', 'disease', 'phoneNumber', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingId', 'queueNo', 'queueType', 'bookingDate', 'bookingTime',
          'status', 'fullName', 'age', 'disease', 'phoneNumber', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.bookingId is string && data.bookingId == bookingId && isValidId(data.bookingId)
        && data.queueNo is string && data.queueNo.size() >= 2 && data.queueNo.size() <= 16
        && data.queueType in ['regular', 'special']
        && data.bookingDate is string && isValidDateId(data.bookingDate)
        && data.bookingTime is string && data.bookingTime.size() >= 5 && data.bookingTime.size() <= 40
        && data.status in ['waiting', 'calling', 'completed', 'cancelled']
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.age is int && data.age >= 1 && data.age <= 120
        && data.disease is string && data.disease.size() <= 160
        && data.phoneNumber is string && data.phoneNumber.size() >= 9 && data.phoneNumber.size() <= 15
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidTreatmentRecord(data) {
      return data.keys().hasAll([
          'bookingId', 'queueNo', 'visitDate', 'patientName', 'phoneNumber',
          'providerName', 'diagnosis', 'createdAt'
        ])
        && data.keys().hasOnly([
          'bookingId', 'queueNo', 'visitDate', 'patientName', 'phoneNumber',
          'providerName', 'diagnosis', 'note', 'createdAt'
        ])
        && data.bookingId is string && isValidId(data.bookingId)
        && data.queueNo is string && data.queueNo.size() >= 2 && data.queueNo.size() <= 16
        && data.visitDate is string && isValidDateId(data.visitDate)
        && data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 120
        && data.phoneNumber is string && data.phoneNumber.size() >= 9 && data.phoneNumber.size() <= 15
        && data.providerName is string && data.providerName.size() >= 2 && data.providerName.size() <= 120
        && data.diagnosis is string && data.diagnosis.size() >= 1 && data.diagnosis.size() <= 240
        && (!('note' in data) || (data.note is string && data.note.size() <= 400))
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function isValidAdminAccount(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'isActive', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'isActive', 'updatedAt'])
        && data.uid is string && data.uid == adminUid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['staff', 'super_admin']
        && data.isActive is bool
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorEmail', 'action', 'targetPath', 'details', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'targetPath', 'details', 'createdAt'])
        && data.actorUid is string && data.actorUid == request.auth.uid && isValidId(data.actorUid)
        && data.actorEmail is string && data.actorEmail.size() >= 1 && data.actorEmail.size() <= 160
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 80
        && data.targetPath is string && data.targetPath.size() >= 1 && data.targetPath.size() <= 160
        && data.details is string && data.details.size() <= 300
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    // --- Collection Rules ---

    // 1. Public Clinic Configuration (non-PII)
    match /clinic_config/{configId} {
      allow get: if configId == 'settings';
      allow list: if false;
      allow create: if configId == 'settings'
        && isValidClinicConfig(incoming())
        && isSuperAdmin();
      allow update: if configId == 'settings'
        && isValidClinicConfig(incoming())
        && isSuperAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['bookingPaused', 'pauseReason', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    // 2. Admin-Defined Open/Closed Calendar Dates (non-PII)
    match /schedule_dates/{dateStr} {
      allow get: if isValidDateId(dateStr);
      allow list: if resource.data.dateStr is string;
      allow create: if isValidDateId(dateStr)
        && isValidScheduleDate(incoming(), dateStr)
        && isSuperAdmin();
      allow update: if isValidDateId(dateStr)
        && isValidScheduleDate(incoming(), dateStr)
        && isSuperAdmin()
        && incoming().dateStr == existing().dateStr
        && incoming().diff(existing()).affectedKeys().hasOnly(['isOpen', 'maxPerSlot', 'note', 'updatedAt']);
      allow delete: if false;
    }

    // 3. Public Non-PII Queue Feed
    match /public_queue/{bookingId} {
      allow get: if isValidId(bookingId);
      allow list: if resource.data.bookingDate is string && resource.data.status in ['waiting', 'calling', 'completed', 'cancelled'];
      allow create: if isValidId(bookingId)
        && isValidPublicQueueItem(incoming(), bookingId)
        && isAdmin();
      allow update: if isValidId(bookingId)
        && isValidPublicQueueItem(incoming(), bookingId)
        && isAdmin()
        && incoming().bookingId == existing().bookingId
        && incoming().diff(existing()).affectedKeys().hasOnly(['queueNo', 'queueType', 'bookingDate', 'bookingTime', 'status', 'updatedAt']);
      allow delete: if false;
    }

    // 4. Protected Bookings with PII (Admin Only)
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isAdmin();
      allow list: if isAdmin() && resource.data.bookingDate is string;
      allow create: if isValidId(bookingId)
        && isValidBookingRecord(incoming(), bookingId)
        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if isValidId(bookingId)
        && isValidBookingRecord(incoming(), bookingId)
        && isAdmin()
        && ((existing().status != 'completed' && existing().status != 'cancelled') || isAdmin())
        && incoming().bookingId == existing().bookingId
        && incoming().createdAt == existing().createdAt
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])) ||
          (isSuperAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'age', 'disease', 'phoneNumber', 'bookingDate', 'bookingTime', 'status', 'notes', 'updatedAt'
          ]))
        );
      allow delete: if false;
    }

    // 5. Protected Treatment History (Admin Only)
    match /treatment_history/{recordId} {
      allow get: if isValidId(recordId) && isAdmin();
      allow list: if isAdmin() && resource.data.visitDate is string;
      allow create: if isValidId(recordId)
        && isValidTreatmentRecord(incoming())
        && isAdmin()
        && exists(/databases/$(database)/documents/bookings/$(incoming().bookingId));
      allow update: if false;
      allow delete: if false;
    }

    // 6. Staff & Super Admin Directory
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAdmin() || (isVerified() && request.auth.uid == adminUid));
      allow list: if isSuperAdmin() && resource.data.uid is string;
      allow create: if isValidId(adminUid)
        && isValidAdminAccount(incoming(), adminUid)
        && isSuperAdmin();
      allow update: if isValidId(adminUid)
        && isValidAdminAccount(incoming(), adminUid)
        && isSuperAdmin()
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'role', 'isActive', 'updatedAt']);
      allow delete: if false;
    }

    // 7. Immutable Audit Logs (Admin Create Only)
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isSuperAdmin();
      allow list: if isSuperAdmin() && resource.data.actorUid is string;
      allow create: if isValidId(logId)
        && isAdmin()
        && isValidAuditLog(incoming());
      allow update: if false;
      allow delete: if false;
    }
  }
}
